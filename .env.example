# Leave as /api in development (Vite proxies it to the backend).
# For production, set the full backend URL, e.g. https://api.nearvo.app/api
VITE_API_URL=/api
# On Vercel set it to your backend's address, e.g. https://nearvo-api.vercel.app/api
# VITE_FILES_URL is only needed if photos are stored on the backend's disk (not with Vercel Blob)

# Shown on the Terms, Privacy and Report pages (fill in before launch)
VITE_LEGAL_NAME=
VITE_BUSINESS_ABN=
VITE_CONTACT_EMAIL=
VITE_BUSINESS_STATE=
VITE_HOSTING_LOCATION=
VITE_LEGAL_UPDATED=
